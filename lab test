import numpy as np

X=np.array([[1,2],[2,3],[3,4],[4,5]])
y=np.array([-1,-1,1,1])

w=np.zeros(1+X.shape[1])
lr=0.01

for i in range(20):
    out=np.dot(X,w[1:])+w[0]
    err=y-out
    w[1:]+=lr*X.T.dot(err)
    w[0]+=lr*err.sum()

pred=np.where(out>=0,1,-1)

print("Weights:",w)
print("Prediction:",pred)


